{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xlb-docs",
  "main": "src/index.js",
  // 本机 wrangler 4.115 自带 workerd 最高支持 2026-07-29；本 Worker 不用新特性，钉住以保证本地预览可跑。
  "compatibility_date": "2026-07-29",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    // 非敏感：Basic Auth 用户名。口令走 `wrangler secret put DOCS_PASSWORD`。
    "DOCS_USER": "xlb"
  },
  "assets": {
    // 由 scripts/stage_docs.sh 用仓库根 docs/ 覆写；不要手改。
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // 关键：所有请求先到 Worker，鉴权无法被静态资源路径绕过。
    "run_worker_first": true
  }
}